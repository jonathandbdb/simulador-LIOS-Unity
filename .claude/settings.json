{
  "statusLine": {
    "type": "command",
    "command": "j=$(cat); d=$(printf '%s' \"$j\" | grep -o '\"project_dir\":[[:space:]]*\"[^\"]*\"' | head -1 | sed -E 's/.*\"project_dir\":[[:space:]]*\"//; s/\"$//'); [ -z \"$d\" ] && d=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; printf '%s' \"$j\" | bash \"$d/.claude/statusline.sh\"",
    "padding": 1
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_orient.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit.sh\""
          }
        ]
      }
    ]
  }
}
