# Configuracion del backend del simulador.
# Copiar a `.env` y editar valores antes de `docker compose up`.
#
# IMPORTANTE: en produccion, regenerar todos los secrets con:
#   openssl rand -hex 32

# ====================================================================
# Modo de despliegue
# ====================================================================
# Local (HTTP, sin certificados):
#   DOMAIN=localhost
#   SCHEME=http://
#   PORT=8080
#
# Produccion (HTTPS automatico via Let's Encrypt):
#   DOMAIN=api.tu-dominio.com
#   SCHEME=             (vacio — Caddy detecta y usa HTTPS automaticamente)
#   PORT=443
#   HTTPS_PORT=443
DOMAIN=localhost
SCHEME=http://
PORT=8080
HTTPS_PORT=443

PUBLIC_BASE_URL=http://localhost:8080

# ====================================================================
# Postgres
# ====================================================================
POSTGRES_USER=simulador
POSTGRES_PASSWORD=changeme
POSTGRES_DB=simulador

# ====================================================================
# MinIO (bucket S3-compatible)
# ====================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=simulador-updates

# ====================================================================
# Auth
# ====================================================================
# Cambiar JWT_SECRET en produccion. Generar: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-me-in-production
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123

# ====================================================================
# CORS de la API publica /api/* (coma-separado). "*" = cualquier origen.
# El panel /admin es server-rendered (mismo origen) y no depende de esto.
# ====================================================================
CORS_ORIGINS=*

# ====================================================================
# Logging
# ====================================================================
LOG_LEVEL=info

# Retencion de logs de actualizacion (UpdateLog, tabla que llena POST
# /api/log). Se purgan automaticamente los mas viejos que N dias: al
# arrancar el backend y, con throttle de 1h, en cada POST /api/log.
LOG_RETENTION_DAYS=30

# ====================================================================
# Provisioning QR de la tablet (Android Enterprise, /admin/provisioning)
# ====================================================================
# Checksum del CERTIFICADO de firma del proyecto (no del APK). Preferido
# sobre el checksum del paquete (calculado automaticamente desde el
# apk_sha256 de la version activa) porque no caduca al publicar una version
# nueva: un QR ya mandado por mail a una clinica sigue siendo valido.
# Configuracion UNICA por proyecto (el keystore no cambia entre releases).
# Se obtiene con (el keytool del propio Editor de Unity, no requiere el JDK
# del sistema):
#   <Editor Unity>/Data/PlaybackEngines/AndroidPlayer/OpenJDK/bin/keytool \
#     -exportcert -alias simulador -keystore keystore/simulador.keystore \
#     | openssl dgst -sha256 -binary | openssl base64 | tr -d '=' | tr -- '+/' '-_'
# Vacio = /admin/provisioning usa el checksum del paquete (apk_sha256 de la
# version activa) como fallback funcional, pero ese SI caduca al publicar
# una version nueva.
# PROVISIONING_SIGNATURE_CHECKSUM=
